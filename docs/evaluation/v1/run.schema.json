{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "run_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "dataset_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dataset Sha256",
      "type": "string"
    },
    "mode": {
      "enum": [
        "live_rules",
        "live_judge",
        "rescore"
      ],
      "title": "Mode",
      "type": "string"
    },
    "status": {
      "default": "queued",
      "enum": [
        "queued",
        "running",
        "cancelling",
        "completed",
        "failed",
        "interrupted"
      ],
      "title": "Status",
      "type": "string"
    },
    "verdict": {
      "default": "incomplete",
      "enum": [
        "passed",
        "failed",
        "incomplete"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "configuration_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Configuration Sha256",
      "type": "string"
    },
    "judge_model": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Judge Model"
    }
  },
  "required": [
    "run_id",
    "dataset_sha256",
    "mode",
    "configuration_sha256"
  ],
  "title": "RunRecord",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
