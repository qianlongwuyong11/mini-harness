          "session_id": "correct-write-2",
          "messages": [{"source_message_id": "correct-msg-2", "role": "user", "content": "修正 Aurora 的同步任务存储决策：从现在起改用 PostgreSQL。此前 SQLite 的方案已废弃，不再是当前方案。"}]
        }
      ],
      "checks": [
        {
          "after_write": 1,
          "scope": {"user_id": "fixture-alice", "project_id": "correction"},
          "session_id": "correct-read-1",
          "query": "Aurora 当前决定用什么数据库保存同步任务状态？",
          "memory_must_support": ["当前方案为 SQLite"],
          "answer_must": ["回答 SQLite"],
          "answer_must_not": ["回答 PostgreSQL"],
          "scope_violation_allowed": false
        },
        {
          "after_write": 2,
          "scope": {"user_id": "fixture-alice", "project_id": "correction"},
          "session_id": "correct-read-2",
          "query": "Aurora 当前决定用什么数据库保存同步任务状态？",
          "memory_must_support": ["当前方案为 PostgreSQL", "SQLite 已被替代或不再作为当前事实"],
          "answer_must": ["明确当前方案是 PostgreSQL"],
          "answer_must_not": ["把 SQLite 说成当前方案", "把两个数据库说成并列有效方案"],
          "scope_violation_allowed": false
        }
      ]
    },
    {
