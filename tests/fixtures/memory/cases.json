{
  "schema_version": 1,
  "dataset_id": "memory-baseline-v1",
  "synthetic": true,
  "cases": [
    {
      "id": "preference",
      "category": "preference",
      "purpose": "在新会话中使用明确的长期偏好",
      "writes": [
        {
          "scope": {"user_id": "fixture-alice", "project_id": "preference"},
          "session_id": "pref-write-1",
          "messages": [{"source_message_id": "pref-msg-1", "role": "user", "content": "以后讲解代码时，请一直用简体中文，先给一句结论，再按编号列出步骤。"}]
        }
      ],
      "checks": [
        {
          "after_write": 1,
          "scope": {"user_id": "fixture-alice", "project_id": "preference"},
          "session_id": "pref-read-1",
          "query": "请说明如何给 Python 函数增加参数校验。",
          "memory_must_support": ["简体中文", "结论在前", "编号步骤"],
          "answer_must": ["使用简体中文", "先给结论，随后给编号步骤"],
          "answer_must_not": ["宣称用户指定过某个 Python 校验库"],
          "scope_violation_allowed": false
        }
      ]
    },
    {
      "id": "correction",
      "category": "correction",
      "purpose": "先验证旧决策，再验证后续明确修正生效",
